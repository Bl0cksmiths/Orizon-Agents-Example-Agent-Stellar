# Copy to .env and edit. Never commit .env — and note that nothing here is a
# secret: this agent verifies a signature, it never makes one, so it holds no
# private key. Your Stellar secret key stays in your wallet, and the only
# place it is ever used is signing the bind challenge in the browser.

# The URL you bound with Orizon, EXACTLY as you registered it.
# It is part of the signed message, so scheme, host, port, path, trailing
# slash and case all matter. A URL that differs by one character will fail
# every signature check, which is the single most common setup mistake.
ORIZON_ENDPOINT_URL=https://your-agent.onrender.com/dispatch

# The G-address Orizon signs dispatches with. Fetch it ONCE and pin it here:
#   curl -s https://orizon-agents-be-stellar.onrender.com/api/stellar/network | grep dispatch_signer
# Leave it EMPTY only while you are getting started: with no signer pinned the
# agent accepts unsigned requests and warns on every one. Once this is set, an
# unsigned or badly-signed request is refused — which is the point.
# Never read the signer from the X-Orizon-Signer header: an attacker sets that
# header to their own key and signs with the matching one.
ORIZON_SIGNER=

# Must match the `network` field in the envelope, or the request is refused.
# A testnet signature is framed identically to a mainnet one, so this is what
# stops a testnet dispatch being replayed at a mainnet-bound agent.
ORIZON_NETWORK=testnet

# Accepted clock skew on the envelope's `ts`, in seconds.
ORIZON_MAX_SKEW=300

# Listen port used only when the platform does NOT provide one. Render, Fly and
# Heroku inject PORT and route to it, and PORT always wins; when it is present
# the agent also binds 0.0.0.0 instead of 127.0.0.1 so the platform can reach it.
ORIZON_PORT=8787

# Bind address. Defaults to 0.0.0.0 on a platform that sets PORT, 127.0.0.1
# otherwise. Override only if you know you need to.
# ORIZON_HOST=127.0.0.1
