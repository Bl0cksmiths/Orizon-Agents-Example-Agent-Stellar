# Copy to .env and fill in. NO SECRETS BELONG IN THIS FILE OR IN .env — the
# reference agent never holds a Stellar secret key. Binding is authorised by
# your browser wallet signing a challenge; nothing here signs anything.

# ---------------------------------------------------------------------------
# Where the agent listens
# ---------------------------------------------------------------------------

# Render, Fly and most hosts inject this. 8080 is the local default.
PORT=8080

# ---------------------------------------------------------------------------
# Verifying that a dispatch really came from Orizon
# ---------------------------------------------------------------------------

# The Orizon dispatch signer, as a Stellar public key (G…).
#
# FETCH IT ONCE AND PIN IT HERE:
#
#   curl -sS https://orizon-agents-be-stellar.onrender.com/api/stellar/network
#   → {"network":"testnet", …, "dispatch_signer":"G…"}
#
# Pin the value you get. NEVER read the signer out of the incoming request's
# X-Orizon-Signer header — that header is a debugging convenience, an attacker
# sets it to their own key, signs with that key, and every check passes. A
# signature is only worth something when it is verified against a key you
# obtained independently.
#
# `dispatch_signer` is null on a deployment with no key configured; then no
# dispatch is signed and there is nothing to verify.
ORIZON_DISPATCH_SIGNER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Refuse an unsigned or badly signed dispatch. Leave this true in production.
# Set it to false only for local curl testing.
ORIZON_REQUIRE_SIGNATURE=true

# The EXACT public URL you bound, copied character for character from the bind
# form. It is part of the signed message, so a trailing slash, a different case
# in the host, or http vs https makes every signature fail to verify. This is
# what makes a signature non-transferable: an envelope signed for another
# operator cannot verify against your URL.
ORIZON_ENDPOINT_URL=https://your-agent.onrender.com/

# The network the dispatch must claim, matched against the envelope's `network`
# field. A testnet signature is framed identically to a mainnet one; this is
# what separates them. Must match `network` from /api/stellar/network above.
ORIZON_NETWORK=testnet

# How far the envelope's `ts` may be from your clock, in seconds, before the
# dispatch is rejected as stale.
ORIZON_MAX_SKEW_SECONDS=300

# ---------------------------------------------------------------------------
# The marketplace API
# ---------------------------------------------------------------------------

ORIZON_API_BASE=https://orizon-agents-be-stellar.onrender.com

# Your agent id, as registered at https://orizons.xyz/app/register. Public.
ORIZON_AGENT_ID=your-agent-id
